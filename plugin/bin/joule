#!/bin/sh
# Puddle — connect Claude Code and Codex to your Puddle dashboard.
#
#   joule setup     sign in (browser), then turn on usage export for Claude Code and Codex
#   joule status    what is connected
#   joule off       disconnect and restore your original settings
#   joule hook      (used by the plugin) tell Puddle which repo a session runs in
#   joule connect   (used by the app) connect Claude Code or Codex again (JOULE_ONLY=claude|codex)
#   joule statusline (used by the app) put Puddle's status line back if Claude Code is connected
#
# Shared: counts, token totals, tool names, timings, prompt lengths, repo names.
# Never shared: prompts, answers, code, file contents, commands, file paths.
set -u

JOULE_DIR="${JOULE_DIR:-$HOME/.joule}"
# Where Puddle lives: an explicit JOULE_URL wins (development: http://127.0.0.1:4500); otherwise the
# address this computer is already connected to, so running setup again never moves it; otherwise
# the website the app was built for (its companion/SERVICE, next to this plugin inside Puddle.app).
DEFAULT_URL="$(head -1 "$(dirname "$0")/../../companion/SERVICE" 2>/dev/null || true)"
JOULE_URL="${JOULE_URL:-$(cat "$JOULE_DIR/url" 2>/dev/null || printf '%s' "$DEFAULT_URL")}"
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_CONFIG="$CODEX_HOME/config.toml"
HERE="$(cd "$(dirname "$0")" && pwd)"
BEGIN='# >>> joule (managed by `joule`; remove with `joule off`) >>>'
END='# <<< joule <<<'
# Every env key Puddle writes into Claude Code settings (so `off` removes exactly these)
KEYS='["JOULE","CLAUDE_CODE_ENABLE_TELEMETRY","OTEL_LOGS_EXPORTER","OTEL_METRICS_EXPORTER","OTEL_EXPORTER_OTLP_PROTOCOL","OTEL_EXPORTER_OTLP_ENDPOINT","OTEL_EXPORTER_OTLP_HEADERS","OTEL_METRIC_EXPORT_INTERVAL","OTEL_LOGS_EXPORT_INTERVAL","OTEL_METRICS_INCLUDE_VERSION","OTEL_METRICS_INCLUDE_REPOSITORY","OTEL_LOG_USER_PROMPTS","OTEL_LOG_ASSISTANT_RESPONSES","OTEL_RESOURCE_ATTRIBUTES"]'

say() { printf '%s\n' "$*"; }
die() { printf 'joule: %s\n' "$*" >&2; exit 1; }

# JSON settings merge: Node, Python 3, or macOS JavaScript — whichever exists.
merge() {
  if command -v node >/dev/null 2>&1; then node "$HERE/merge.cjs" "$@"
  elif command -v python3 >/dev/null 2>&1 && python3 -c 'import json' >/dev/null 2>&1; then python3 "$HERE/merge.py" "$@"
  elif command -v osascript >/dev/null 2>&1; then osascript -l JavaScript "$HERE/merge.cjs" "$@" 2>&1
  else die "needs node, python3 or macOS to edit settings"; fi
}

post() { # url json [token]
  if [ -n "${3:-}" ]; then
    curl -fsS -m 10 -X POST -H 'content-type: application/json' -H "authorization: Bearer $3" --data "$2" "$1"
  else
    curl -fsS -m 10 -X POST -H 'content-type: application/json' --data "$2" "$1"
  fi
}
field() { tr '\n' ' ' | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"; }   # tiny JSON string field reader (compact or pretty JSON)
token() { [ -f "$JOULE_DIR/token" ] && cat "$JOULE_DIR/token"; }

timezone() { # e.g. Europe/Berlin, from the system clock setting
  tz="$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*zoneinfo/||p')"
  [ -z "$tz" ] && [ -f /etc/timezone ] && tz="$(cat /etc/timezone)"
  printf '%s' "$tz"
}
country() { # region from the macOS locale (en_DE → DE) or $LANG
  loc="$(defaults read -g AppleLocale 2>/dev/null || printf '%s' "${LANG:-}")"
  printf '%s' "$loc" | sed -n 's/^[a-zA-Z]*_\([A-Z][A-Z]\).*/\1/p'
}
urlenc() { printf '%s' "$1" | sed 's|%|%25|g; s|/|%2F|g; s| |%20|g; s|,|%2C|g; s|=|%3D|g'; }

# ---- sign in (device flow) --------------------------------------------------
login() {
  existing="$(token || true)"
  if [ -n "$existing" ]; then say "Already signed in."; return 0; fi
  [ -n "$JOULE_URL" ] || die "this copy of Puddle has no website to sign in to (set JOULE_URL to use one)"
  label="$(hostname 2>/dev/null | sed 's/\.local$//')"
  start="$(post "$JOULE_URL/api/device/start" "{\"label\":\"$label\"}")" || die "can't reach Puddle at $JOULE_URL"
  device="$(printf '%s' "$start" | field device_code)"
  code="$(printf '%s' "$start" | field user_code)"
  link="$(printf '%s' "$start" | field verification_uri_complete)"
  say ""
  say "  Confirm this code in your browser:  $code"
  say "  $link"
  say ""
  if [ "${JOULE_NO_BROWSER:-}" != "1" ]; then
    (open "$link" || xdg-open "$link" || start "$link") >/dev/null 2>&1 || true
  fi
  i=0
  while [ $i -lt 300 ]; do # up to 10 minutes
    sleep 2; i=$((i + 1))
    r="$(curl -sS -m 10 -o /dev/stdout -w '\n%{http_code}' -X POST -H 'content-type: application/json' --data "{\"device_code\":\"$device\"}" "$JOULE_URL/api/device/poll" 2>/dev/null)" || continue
    status="$(printf '%s' "$r" | tail -n 1)"
    body="$(printf '%s' "$r" | sed '$d')"
    case "$status" in
      200)
        t="$(printf '%s' "$body" | field token)"
        [ -n "$t" ] || die "unexpected answer from Puddle"
        mkdir -p "$JOULE_DIR" && chmod 700 "$JOULE_DIR"
        (umask 077; printf '%s' "$t" > "$JOULE_DIR/token")
        printf '%s' "$JOULE_URL" > "$JOULE_DIR/url"
        say "Signed in as $(printf '%s' "$body" | field email)."
        return 0 ;;
      202) ;;
      *) die "the code expired or was cancelled — run \`joule setup\` again" ;;
    esac
  done
  die "timed out waiting for the browser"
}

# ---- Claude Code --------------------------------------------------------------
claude_on() {
  t="$1"
  attrs="user.timezone=$(urlenc "$(timezone)"),user.country=$(country)"
  env="{\"JOULE\":\"joule:$JOULE_URL\",\"CLAUDE_CODE_ENABLE_TELEMETRY\":\"1\",\"OTEL_LOGS_EXPORTER\":\"otlp\",\"OTEL_METRICS_EXPORTER\":\"otlp\",\"OTEL_EXPORTER_OTLP_PROTOCOL\":\"http/json\",\"OTEL_EXPORTER_OTLP_ENDPOINT\":\"$JOULE_URL\",\"OTEL_EXPORTER_OTLP_HEADERS\":\"Authorization=Bearer $t\",\"OTEL_METRIC_EXPORT_INTERVAL\":\"10000\",\"OTEL_LOGS_EXPORT_INTERVAL\":\"5000\",\"OTEL_METRICS_INCLUDE_VERSION\":\"true\",\"OTEL_METRICS_INCLUDE_REPOSITORY\":\"1\",\"OTEL_LOG_USER_PROMPTS\":\"0\",\"OTEL_LOG_ASSISTANT_RESPONSES\":\"0\",\"OTEL_RESOURCE_ATTRIBUTES\":\"$attrs\"}"
  mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
  out="$(merge on "$CLAUDE_SETTINGS" "$JOULE_DIR/claude-settings.backup" "$env")"
  case "$out" in
    *JOULE3:*) say "  Claude Code: skipped — it already sends usage to ${out#*JOULE3:}. Turn that off first, then run \`joule setup\` again."; return 1 ;;
  esac
  statusline_on
  say "  Claude Code: connected (restart it to start sharing)."
}
claude_off() {
  [ -f "$CLAUDE_SETTINGS" ] || return 0
  statusline_off
  merge off "$CLAUDE_SETTINGS" "$JOULE_DIR/claude-settings.backup" "$KEYS" >/dev/null && say "  Claude Code: disconnected."
}

# Plan limits: Claude Code shows them only to a status line, so Puddle's status line passes the numbers
# (5-hour and weekly % used, reset times) to Puddle on this Mac and shows the status line you had, if any.
# The wrapper is a fixed path, rewritten each time with where Puddle's node and script are now.
statusline_on() {
  node_bin="$(command -v node 2>/dev/null)" || return 0
  w="$JOULE_DIR/statusline.sh"
  mkdir -p "$JOULE_DIR"
  {
    printf '#!/bin/sh\n'
    printf "# Puddle's Claude Code status line (written by Puddle; signing out of Puddle puts yours back).\n"
    printf 'N="%s"; S="%s"\n' "$node_bin" "$HERE/statusline.cjs"
    printf 'export JOULE_DIR="%s"\n' "$JOULE_DIR"
    printf 'if [ -x "$N" ] && [ -f "$S" ]; then exec "$N" "$S"; fi\n'
    printf "# Puddle isn't here any more: your own status line, or nothing\n"
    printf 'if [ -f "$JOULE_DIR/statusline-prev.sh" ]; then exec /bin/sh "$JOULE_DIR/statusline-prev.sh"; fi\n'
    printf 'cat >/dev/null\n'
  } > "$w"
  chmod 755 "$w"
  merge statusline-on "$CLAUDE_SETTINGS" "$w" "$JOULE_DIR/statusline-prev" >/dev/null 2>&1 || true
}
statusline_off() {
  merge statusline-off "$CLAUDE_SETTINGS" "$JOULE_DIR/statusline.sh" "$JOULE_DIR/statusline-prev" >/dev/null 2>&1 || true
  rm -f "$JOULE_DIR/statusline.sh"
}

# ---- Codex (~/.codex/config.toml) ----------------------------------------------
codex_strip() { # remove our block, keep everything else byte for byte
  [ -f "$CODEX_CONFIG" ] || return 0
  awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' "$CODEX_CONFIG" > "$CODEX_CONFIG.joule-tmp" && mv "$CODEX_CONFIG.joule-tmp" "$CODEX_CONFIG"
}
codex_on() {
  t="$1"
  mkdir -p "$CODEX_HOME"
  [ -f "$CODEX_CONFIG" ] || : > "$CODEX_CONFIG"
  if grep -qF "$BEGIN" "$CODEX_CONFIG"; then
    codex_strip # setting up again: replace our block, the backup from the first setup stays
  else
    if grep -Eq '^[[:space:]]*\[otel\]|^[[:space:]]*otel[[:space:]]*=' "$CODEX_CONFIG"; then
      say "  Codex: skipped — config.toml already has an [otel] section. Remove it first, then run \`joule setup\` again."; return 1
    fi
    cp "$CODEX_CONFIG" "$JOULE_DIR/codex-config.backup" # exact original bytes, before any change
  fi
  # Codex sends this header as written (no variable expansion), so the token is literal.
  {
    [ -s "$CODEX_CONFIG" ] && [ "$(tail -c 1 "$CODEX_CONFIG" | od -An -c | tr -d ' ')" != '\n' ] && printf '\n'
    printf '%s\n' "$BEGIN"
    printf '[otel]\n'
    printf 'exporter = { otlp-http = { endpoint = "%s/v1/logs", protocol = "json", headers = { "authorization" = "Bearer %s" } } }\n' "$JOULE_URL" "$t"
    printf 'log_user_prompt = false\n'
    printf '%s\n' "$END"
  } >> "$CODEX_CONFIG"
  say "  Codex: connected (restart Codex to start sharing)."
}
codex_off() {
  [ -f "$CODEX_CONFIG" ] || return 0
  grep -qF "$BEGIN" "$CODEX_CONFIG" || return 0
  codex_strip
  if [ -f "$JOULE_DIR/codex-config.backup" ]; then
    # nothing else changed → restore the exact original bytes
    if cmp -s "$CODEX_CONFIG" "$JOULE_DIR/codex-config.backup" || [ "$(cat "$CODEX_CONFIG")" = "$(cat "$JOULE_DIR/codex-config.backup")" ]; then
      cp "$JOULE_DIR/codex-config.backup" "$CODEX_CONFIG"
    fi
    rm -f "$JOULE_DIR/codex-config.backup"
  fi
  say "  Codex: disconnected."
}

# ---- commands -------------------------------------------------------------------
cmd_setup() {
  command -v curl >/dev/null 2>&1 || die "needs curl"
  say "Puddle shares how you use Claude Code and Codex — counts, token totals, tool names,"
  say "timings, prompt lengths and repo names — with your own Puddle dashboard."
  say "It never shares your prompts, the agent's answers, code, commands or file paths."
  login
  t="$(token)"
  done_any=0
  if [ "${JOULE_ONLY:-}" != "codex" ] && { [ -d "$(dirname "$CLAUDE_SETTINGS")" ] || command -v claude >/dev/null 2>&1; }; then claude_on "$t" && done_any=1; fi
  if [ "${JOULE_ONLY:-}" != "claude" ] && { [ -d "$CODEX_HOME" ] || command -v codex >/dev/null 2>&1; }; then codex_on "$t" && done_any=1; fi
  [ "$done_any" = 1 ] || say "  Nothing was changed."
  say ""
  say "Your dashboard: $JOULE_URL"
  say "Restart Claude Code / Codex (quit and reopen the apps) to start sharing."
}
# The Puddle app connects this computer itself: it already holds a device key (from a one-time
# pairing link), so there's no sign-in here. The key comes in JOULE_TOKEN (never as an argument:
# arguments are visible to other programs), the address in JOULE_URL.
cmd_connect() {
  [ -n "${JOULE_TOKEN:-}" ] || die "connect needs JOULE_TOKEN (the Puddle app passes it)"
  case "$JOULE_TOKEN" in jl_*) ;; *) die "that doesn't look like a Puddle device key" ;; esac
  mkdir -p "$JOULE_DIR" && chmod 700 "$JOULE_DIR"
  ( umask 077; printf '%s' "$JOULE_TOKEN" > "$JOULE_DIR/token"; printf '%s' "$JOULE_URL" > "$JOULE_DIR/url" )
  done_any=0
  if [ "${JOULE_ONLY:-}" != "codex" ] && { [ -d "$(dirname "$CLAUDE_SETTINGS")" ] || command -v claude >/dev/null 2>&1; }; then claude_on "$JOULE_TOKEN" && done_any=1; fi
  if [ "${JOULE_ONLY:-}" != "claude" ] && { [ -d "$CODEX_HOME" ] || command -v codex >/dev/null 2>&1; }; then codex_on "$JOULE_TOKEN" && done_any=1; fi
  [ "$done_any" = 1 ] || say "  Nothing was changed."
}
cmd_status() {
  if [ -n "$(token || true)" ]; then say "Signed in · $(cat "$JOULE_DIR/url" 2>/dev/null || printf '%s' "$JOULE_URL")"; else say "Not signed in"; fi
  ep="$( [ -f "$CLAUDE_SETTINGS" ] && merge get "$CLAUDE_SETTINGS" JOULE 2>/dev/null)"
  case "$ep" in joule:*) say "Claude Code: connected" ;; *) say "Claude Code: not connected" ;; esac
  if [ -f "$CODEX_CONFIG" ] && grep -qF "$BEGIN" "$CODEX_CONFIG"; then say "Codex: connected"; else say "Codex: not connected"; fi
}
cmd_off() {
  claude_off
  codex_off
  t="$(token 2>/dev/null || true)"
  # cancel this computer's key on the server too (best effort: works offline as well)
  [ -n "$t" ] && post "$(cat "$JOULE_DIR/url" 2>/dev/null || printf '%s' "$JOULE_URL")/api/token/revoke" '{}' "$t" >/dev/null 2>&1 || true
  rm -f "$JOULE_DIR/token" "$JOULE_DIR/url"
  say "Disconnected. Restart Claude Code / Codex for it to take effect. Your data stays on your dashboard until you delete it there."
}
# SessionStart hook: tells Puddle the repo (remote URL, without credentials) and
# folder name of a session so work can be attributed. Never blocks the session.
cmd_hook() {
  agent="${1:-claude-code}"
  t="$(token 2>/dev/null || true)"; [ -n "$t" ] || exit 0
  input="$(cat)"
  sid="$(printf '%s' "$input" | field session_id)"
  cwd="$(printf '%s' "$input" | field cwd)"
  src="$(printf '%s' "$input" | field source)"
  [ -n "$sid" ] || exit 0
  repo="$(git -C "$cwd" remote get-url origin 2>/dev/null | sed -E 's#//[^@/]*@#//#; s#\.git$##' || true)"
  folder="$(basename "$cwd" 2>/dev/null || true)"
  esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
  # Which account this computer's Claude Code uses, so "what to share" can say "Claude · Acme".
  # Puddle never sends the account id itself, only its fingerprint (the same one the website keeps
  # from Claude Code's own telemetry, which drops the id on arrival). A company name is sent only
  # for work plans (Team/Enterprise).
  account=""
  cfg="${CLAUDE_CONFIG_DIR:+$CLAUDE_CONFIG_DIR/.claude.json}"; [ -f "${cfg:-}" ] || cfg="$HOME/.claude.json"
  if [ "$agent" = claude-code ] && [ -f "$cfg" ]; then
    org="$(field organizationUuid < "$cfg" | head -1)"
    if [ -n "$org" ]; then
      fp="$(printf 'joule|%s' "$org" | { shasum -a 256 2>/dev/null || sha256sum; } | cut -c1-16)"
      type="$(field organizationType < "$cfg" | head -1)"
      name=""; case "$type" in *team*|*enterprise*) name="$(field organizationName < "$cfg" | head -1)" ;; esac
      account=",\"account\":{\"org_hash\":\"$fp\",\"type\":\"$(esc "$type")\",\"name\":\"$(esc "$name")\"}"
    fi
  fi
  post "$(cat "$JOULE_DIR/url" 2>/dev/null || printf '%s' "$JOULE_URL")/api/session-context" \
    "{\"session_id\":\"$(esc "$sid")\",\"agent\":\"$agent\",\"repo\":\"$(esc "$repo")\",\"folder\":\"$(esc "$folder")\",\"source\":\"$(esc "$src")\"$account}" "$t" >/dev/null 2>&1 || true
  exit 0
}

case "${1:-setup}" in
  connect) shift; cmd_connect "$@" ;;
  setup|on) cmd_setup ;;
  status) cmd_status ;;
  off|leave) cmd_off ;;
  hook) shift; cmd_hook "$@" ;;
  # the app, at every start: Claude Code connected → Puddle's status line in place, pointing at this copy of Puddle
  statusline) if [ -n "$(token || true)" ] && [ -f "$CLAUDE_SETTINGS" ]; then case "$(merge get "$CLAUDE_SETTINGS" JOULE 2>/dev/null)" in joule:*) statusline_on ;; esac; fi ;;
  *) say "usage: joule setup | status | off" ;;
esac
