{
  "name": "puddle",
  "version": "0.0.9",
  "description": "Puddle: a Mac menu bar app showing how people use their coding agents (Claude Code, Codex). Counts and timings only, never prompts or code",
  "license": "MIT",
  "homepage": "https://puddle.rip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bastaff/puddle.git"
  },
  "bugs": {
    "url": "https://github.com/Bastaff/puddle/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:changed": "node scripts/test-for.mjs",
    "companion": "node --disable-warning=ExperimentalWarning companion/server.js",
    "dev:app": "node scripts/dev-app.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "playwright-core": "1.48.2"
  }
}
